{
  "name": "app-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build --configuration=production && mv ../src/main/resources/static/browser/* ../src/main/resources/static && rmdir ../src/main/resources/static/browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint . --format unix",
    "lint:a11y": "eslint \"src/**/*.html\" --format unix --max-warnings 0",
    "build:demo": "ng build --configuration demo --base-href=/accessible-job-manager/",
    "check:demo": "node tools/demo-network-check.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^22.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-formatter-unix": "^9.0.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "puppeteer": "^25.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
