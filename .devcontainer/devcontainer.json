{
  "name": "accessible-job-manager",

  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "26",
      "jdkDistro": "tem",
      "installGradle": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    }
  },

  "forwardPorts": [8060, 9000, 9443, 5432, 3900, 3901, 3909, 3000],
  "portsAttributes": {
    "8060": { "label": "Backend (Spring Boot)" },
    "9000": { "label": "Authentik (OIDC)" },
    "9443": { "label": "Authentik (OIDC, TLS)" },
    "5432": { "label": "PostgreSQL" },
    "3900": { "label": "Garage S3" },
    "3901": { "label": "Garage Admin" },
    "3909": { "label": "Garage WebUI" },
    "3000": { "label": "Gotenberg (PDF)" }
  },

  "postCreateCommand": "chmod +x gradlew && ./gradlew --version && npm ci --prefix AppClient",

  "customizations": {
    "jetbrains": {
      "backend": "IntelliJ"
    },
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "Angular.ng-template"
      ]
    }
  },

  "remoteUser": "root"
}
