# --- Database --------------------------------------------------------------
MANAGER_DB_URL=jdbc:postgresql://localhost:5432/manager
MANAGER_DB_USER=manager
MANAGER_DB_PASSWORD=

# --- OIDC / Authentik ------------------------------------------------------
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER_URI=http://localhost:9000/application/o/access-job-manager/
OIDC_AUTH_URI=http://localhost:9000/application/o/authorize/
OIDC_REDIRECT_URI=http://localhost:8060/login/oauth2/code/authentik
# Where the provider sends the browser after logout. Must also be registered as a
# redirect URI on the provider, or it will refuse the post-logout redirect.
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8060/

# Identity provider groups mapped to the three application roles. Only these three
# roles are ever granted; a group not named here confers nothing. Values are whatever
# the provider emits - group names, or object GUIDs on Entra ID - and several may be
# given per role, comma separated.
GROUP_USER=User
GROUP_ADVISOR=Advisor
GROUP_REVIEWER=Reviewer

# --- Session cookie --------------------------------------------------------
# Marks JSESSIONID as Secure, so the browser only sends it over HTTPS. Stays
# false locally because the dev stack is plain http://localhost, where a Secure
# cookie would never be sent back and no session would survive. Any deployment
# that terminates TLS must set this to true.
COOKIE_SECURE=false

# --- Object storage --------------------------------------------------------
# `s3` talks to the local Garage container; `azure` uses the connection string
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=job-manager
REGION=garage
ACCESS_KEY=
SECRET_KEY=

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents

# --- PDF rendering ---------------------------------------------------------
GOTENBERG_URL=http://localhost:3000

# --- Job posting extraction ------------------------------------------------
# `ollama` runs the model locally and needs no key; `azure` needs the four
JOB_POSTING_LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_API_KEY=

# --- Advisor job search (Adzuna) -------------------------------------------
# Optional. Without a key the advisor job search stays switched off
JOBSOURCE_ADZUNA_APP_ID=
JOBSOURCE_ADZUNA_APP_KEY=
JOBSOURCE_ADZUNA_BASE_URL=https://api.adzuna.com/v1/api
JOBSOURCE_ADZUNA_COUNTRY=de
JOBSOURCE_ADZUNA_MAX_RESULTS=50

# --- Logging ---------------------------------------------------------------
# Standard log levels (TRACE/DEBUG/INFO/WARN/ERROR). application.yml ships INFO
# for all of them; raise them here when debugging locally. SECURITY and OAUTH2
# print the login flow, WEB_CLIENT the outgoing HTTP calls (Gotenberg, Adzuna,
# the LLM provider), JOBSOURCE the advisor job search.
SECURITY_LOG_LEVEL=INFO
OAUTH2_LOG_LEVEL=INFO
WEB_CLIENT_LOG_LEVEL=INFO
JOBSOURCE_LOG_LEVEL=INFO
